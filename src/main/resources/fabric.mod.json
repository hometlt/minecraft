{
	"schemaVersion": 1,
	"id": "starmine",
	"version": "${version}",
	"name": "StarMine",
	"description": "StarCraft II zerg and terrans in Minecraft. Models, textures and sounds are imported by Modkit from your own StarCraft II installation; this mod ships none of them.",
	"authors": ["StarMine"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.starmine.StarMine"],
		"client": ["dev.starmine.client.StarMineClient"],
		"fabric-gametest": ["dev.starmine.entity.DroneGameTests", "dev.starmine.entity.TerranGameTests", "dev.starmine.entity.VespeneGameTests", "dev.starmine.faction.FactionGameTests", "dev.starmine.race.RaceGameTests", "dev.starmine.world.StructureGameTests", "dev.starmine.ability.AbilityGameTests", "dev.starmine.possess.PossessionGameTests", "dev.starmine.ability.MechanicsGameTests", "dev.starmine.ability.ZergAbilityGameTests", "dev.starmine.ability.TerranAbilityGameTests", "dev.starmine.ability.ProtossAbilityGameTests", "dev.starmine.entity.PathfindingGameTests"]
	},
	"mixins": ["starmine.mixins.json", {"config": "starmine.client.mixins.json", "environment": "client"}],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
