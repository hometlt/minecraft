{
	"schemaVersion": 1,
	"id": "starmine",
	"version": "${version}",
	"name": "StarMine",
	"description": "StarCraft II zerg in Minecraft. Models, textures and sounds are imported by Modkit from your own StarCraft II installation; this mod ships none of them.",
	"authors": ["StarMine"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.starmine.StarMine"],
		"client": ["dev.starmine.client.StarMineClient"],
		"fabric-gametest": ["dev.starmine.entity.DroneGameTests"]
	},
	"mixins": ["starmine.mixins.json"],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
